<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
    <!-- Could you be our best partner? -->
    <record model="survey.survey" id="lead_qualification_survey_template">
        <field name="survey_type">survey</field>
        <field name="title">Could you be our best partner?</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="access_mode">public</field>
        <field name="is_attempts_limited" eval="True"/>
        <field name="users_can_go_back" eval="False" />
        <field name="description" type="html">
            <p>Welcome to this survey, <br/><br/>
                You are receiving this survey because you are likely to become one of our partners.<br/>
                Once you've submitted this survey, one of our managers will follow up the integration process based on your answers.</p>
        </field>
        <field name="description_done" type="html">
            <p>Thanks a lot for your participation!</p>
        </field>
        <field name="lang_ids" eval="False"/>
    </record>
    <record model="survey.question" id="lead_qualification_survey_0">
        <field name="title">About you</field>
        <field name="survey_id" ref="lead_qualification_survey_template"/>
        <field name="is_page" eval="True"/>
        <field name="question_type" eval="False"/>
        <field name="sequence">0</field>
        <field name="description" type="html"><p> </p></field>
    </record>

    <record model="survey.question" id="lead_qualification_survey_1">
        <field name="title">Had you heard of our company before receiving this survey?</field>
        <field name="survey_id" ref="lead_qualification_survey_template"/>
        <field name="question_type" eval="False"/>
        <field name="sequence">1</field>
        <field name="question_type">simple_choice</field>
        <field name="constr_mandatory" eval="True"/>
    </record>
        <record id="lead_qualification_survey_1_sug1" model="survey.question.answer">
            <field name="question_id" ref="lead_qualification_survey_1"/>
            <field name="sequence">1</field>
            <field name="value">Yes</field>
        </record>
        <record id="lead_qualification_survey_1_sug2" model="survey.question.answer">
            <field name="question_id" ref="lead_qualification_survey_1"/>
            <field name="sequence">2</field>
            <field name="value">No</field>
        </record>

    <record model="survey.question" id="lead_qualification_survey_2">
        <field name="survey_id" ref="lead_qualification_survey_template"/>
        <field name="sequence">2</field>
        <field name="title">What's your name?</field>
        <field name="question_type">char_box</field>
        <field name="constr_mandatory" eval="True"/>
        <field name="save_as_nickname" eval="True"/>
    </record>

    <record model="survey.question" id="lead_qualification_survey_3">
        <field name="survey_id" ref="lead_qualification_survey_template"/>
        <field name="sequence">3</field>
        <field name="title">What's your position?</field>
        <field name="question_type">char_box</field>
        <field name="constr_mandatory" eval="True"/>
    </record>

    <record model="survey.question" id="lead_qualification_survey_4">
        <field name="title">About your company</field>
        <field name="survey_id" ref="lead_qualification_survey_template"/>
        <field name="is_page" eval="True"/>
        <field name="question_type" eval="False"/>
        <field name="sequence">4</field>
        <field name="description" type="html"><p> </p></field>
    </record>

    <record model="survey.question" id="lead_qualification_survey_5">
        <field name="survey_id" ref="lead_qualification_survey_template"/>
        <field name="sequence">5</field>
        <field name="title">What's your company name?</field>
        <field name="question_type">char_box</field>
        <field name="constr_mandatory" eval="True"/>
    </record>

    <record model="survey.question" id="lead_qualification_survey_6">
        <field name="survey_id" ref="lead_qualification_survey_template"/>
        <field name="sequence">6</field>
        <field name="title">What's your industry?</field>
        <field name="question_type">multiple_choice</field>
        <field name="constr_mandatory" eval="True"/>
    </record>
        <record id="lead_qualification_survey_6_sug1" model="survey.question.answer">
            <field name="question_id" ref="lead_qualification_survey_6"/>
            <field name="sequence">1</field>
            <field name="value">Agriculture</field>
        </record>
        <record id="lead_qualification_survey_6_sug2" model="survey.question.answer">
            <field name="question_id" ref="lead_qualification_survey_6"/>
            <field name="sequence">2</field>
            <field name="value">Manufacturing/Industry</field>
        </record>
        <record id="lead_qualification_survey_6_sug3" model="survey.question.answer">
            <field name="question_id" ref="lead_qualification_survey_6"/>
            <field name="sequence">3</field>
            <field name="value">Services</field>
        </record>
        <record id="lead_qualification_survey_6_sug4" model="survey.question.answer">
            <field name="question_id" ref="lead_qualification_survey_6"/>
            <field name="sequence">4</field>
            <field name="value">IT</field>
            <field name="create_lead">True</field>
        </record>
        <record id="lead_qualification_survey_6_sug5" model="survey.question.answer">
            <field name="question_id" ref="lead_qualification_survey_6"/>
            <field name="sequence">5</field>
            <field name="value">Retail Store</field>
        </record>
        <record id="lead_qualification_survey_6_sug6" model="survey.question.answer">
            <field name="question_id" ref="lead_qualification_survey_6"/>
            <field name="sequence">6</field>
            <field name="value">Administrative</field>
        </record>
        <record id="lead_qualification_survey_6_sug7" model="survey.question.answer">
            <field name="question_id" ref="lead_qualification_survey_6"/>
            <field name="sequence">7</field>
            <field name="value">Research Lab</field>
            <field name="create_lead">True</field>
        </record>
        <record id="lead_qualification_survey_6_sug8" model="survey.question.answer">
            <field name="question_id" ref="lead_qualification_survey_6"/>
            <field name="sequence">8</field>
            <field name="value">Other</field>
        </record>

    <record model="survey.question" id="lead_qualification_survey_7">
        <field name="survey_id" ref="lead_qualification_survey_template"/>
        <field name="sequence">7</field>
        <field name="title">What's your company size?</field>
        <field name="question_type">simple_choice</field>
        <field name="constr_mandatory" eval="True"/>
    </record>
        <record id="lead_qualification_survey_7_sug1" model="survey.question.answer">
            <field name="question_id" ref="lead_qualification_survey_7"/>
            <field name="sequence">1</field>
            <field name="value">1 - 9</field>
        </record>
        <record id="lead_qualification_survey_7_sug2" model="survey.question.answer">
            <field name="question_id" ref="lead_qualification_survey_7"/>
            <field name="sequence">2</field>
            <field name="value">10 - 99</field>
        </record>
        <record id="lead_qualification_survey_7_sug3" model="survey.question.answer">
            <field name="question_id" ref="lead_qualification_survey_7"/>
            <field name="sequence">3</field>
            <field name="value">10 - 499</field>
            <field name="create_lead">True</field>
        </record>
        <record id="lead_qualification_survey_7_sug4" model="survey.question.answer">
            <field name="question_id" ref="lead_qualification_survey_7"/>
            <field name="sequence">4</field>
            <field name="value">500 +</field>
        </record>

    <record model="survey.question" id="lead_qualification_survey_8">
        <field name="title">About us</field>
        <field name="survey_id" ref="lead_qualification_survey_template"/>
        <field name="is_page" eval="True"/>
        <field name="question_type" eval="False"/>
        <field name="sequence">8</field>
        <field name="description" type="html"><p> </p></field>
    </record>

    <record model="survey.question" id="lead_qualification_survey_9">
        <field name="survey_id" ref="lead_qualification_survey_template"/>
        <field name="sequence">9</field>
        <field name="title">Have you ever worked with any of the following?</field>
        <field name="question_type">matrix</field>
        <field name="matrix_subtype">simple</field>
    </record>
            <record model="survey.question.answer" id="lead_qualification_survey_col_1">
                <field name="question_id" ref="lead_qualification_survey_9"/>
                <field name="sequence">1</field>
                <field name="value">Yes</field>
                <field name="create_lead">True</field>
            </record>
            <record model="survey.question.answer" id="lead_qualification_survey_row_1">
                <field name="matrix_question_id" ref="lead_qualification_survey_9"/>
                <field name="sequence">1</field>
                <field name="value">Our company in the past?</field>
            </record>
            <record model="survey.question.answer" id="lead_qualification_survey_row_2">
                <field name="matrix_question_id" ref="lead_qualification_survey_9"/>
                <field name="sequence">2</field>
                <field name="value">One of our collaborators?</field>
            </record>
            <record model="survey.question.answer" id="lead_qualification_survey_row_3">
                <field name="matrix_question_id" ref="lead_qualification_survey_9"/>
                <field name="sequence">3</field>
                <field name="value">An IT-oriented company?</field>
            </record>
            <record model="survey.question.answer" id="lead_qualification_survey_row_4">
                <field name="matrix_question_id" ref="lead_qualification_survey_9"/>
                <field name="sequence">4</field>
                <field name="value">A client-relationship company?</field>
            </record>

    <record model="survey.question" id="lead_qualification_survey_10">
        <field name="survey_id" ref="lead_qualification_survey_template"/>
        <field name="sequence">10</field>
        <field name="title">Would you like to share any thoughts on our potential future collaboration?</field>
        <field name="question_type">text_box</field>
    </record>

    <record model="survey.question" id="lead_qualification_survey_11">
        <field name="survey_id" ref="lead_qualification_survey_template"/>
        <field name="sequence">11</field>
        <field name="title">Your email:</field>
        <field name="question_type">char_box</field>
        <field name="constr_mandatory" eval="True"/>
        <field name="validation_email">True</field>
        <field name="save_as_email">True</field>
    </record>
    </data>
</odoo>
