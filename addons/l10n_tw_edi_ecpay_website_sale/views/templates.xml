<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- /shop/l10n_mx_invoicing_info route -->
    <template id="l10n_tw_edi_invoicing_info">
        <t t-call="website_sale.checkout_layout">
            <t t-set="additional_title">ECpay information</t>
            <t t-set="show_navigation_button" t-value="False"/>
            <t t-set="oe_structure">
                <!-- This is the drag-and-drop area for website building blocs at the end of each
                     checkout page. This is append at the of the page in `checkout_layout`. The
                     templates created in the database to store blocs are hooked using XPath on the
                     `oe_struture` element ID. Therefore, we can't use dynamic IDs (like with
                     t-att-id) and each template needs to define a div element. -->
                <div class="oe_structure" id="oe_structure_l10n_tw_edi_website_sale_extra_info_1"/>
            </t>
            <section>
                <div t-attf-class="container">
                    <h3 class="mb24">ECpay E-invoice Info</h3>
                    <form
                        action="/shop/l10n_tw_invoicing_info"
                        method="post"
                        id="ecpay_invoice_form"
                        t-att-date-order-id="website_sale_order.id"
                        t-att-data-access-token="website_sale_order.access_token"
                    >
                        <t t-if="errors" t-foreach="errors.values()" t-as="err">
                            <h5 class="text-danger" t-esc="err" />
                        </t>
                        <div id="ecpay_invoice_method" class="mt-3">
                            <div class="row">
                                <div id="ecpay_invoice_print" class="mb-3 col-md-7">
                                    <select class="form-control" id="print_group" name="print_group">
                                        <option t-if="not default_vals['is_b2b']" t-attf-value="0" t-att-selected="default_vals['print_group'] == '0'">Not generate PDF invoice on Ecpay platform</option>
                                        <option t-attf-value="1" t-att-selected="default_vals['print_group'] == '1'">Generate PDF invoice on Ecpay platform</option>
                                        <option t-if="not default_vals['is_b2b']" t-attf-value="2" t-att-selected="default_vals['print_group'] == '2'">Donate</option>
                                    </select>
                                </div>
                            </div>
                            <div id="ecpay_invoice_tax_id" t-att-class="'d-none' if default_vals['print_group'] != '1' or not default_vals['is_b2b'] else ''" class="row">
                                <div id="div-identifier" class="col-md-7">
                                    <label for="identifier" class="form-label">Company's Tax ID</label>
                                        <div class="input-group">
                                        <input
                                            class="form-control"
                                            id="identifier"
                                            maxlength="8"
                                            name="identifier"
                                            type="text"
                                            placeholder="Tax ID Number format is 8 digits"
                                            t-att-value="default_vals['identifier']"
                                        />
                                        <button type="button" id="validate_tax_id" class="btn btn-outline-primary btn-sm d-none">
                                            Validate Tax ID
                                        </button>
                                        <button type="button" id="reenter_tax_id" class="btn btn-outline-primary btn-sm d-none">
                                            ReEnter Tax ID
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div id="ecpay_carrier_type_group" t-att-class="'d-none' if default_vals['print_group'] != '0' else ''">
                                <div class="row">
                                    <div id="carrier_type_selection" class="mb-3 col-md-7">
                                        <label for="l10n_tw_edi_carrier_type">Carrier</label>
                                        <select class="form-control" id="l10n_tw_edi_carrier_type" name="l10n_tw_edi_carrier_type">
                                            <option t-attf-value="0" t-att-selected="default_vals['carrier_type'] == '0'"/>
                                            <option t-attf-value="1" t-att-selected="default_vals['carrier_type'] == '1'">ECpay e-invoice carrier</option>
                                            <option t-attf-value="2" t-att-selected="default_vals['carrier_type'] == '2'">Citizen Digital Certificate</option>
                                            <option t-attf-value="3" t-att-selected="default_vals['carrier_type'] == '3'">Mobile Barcode</option>
                                        </select>
                                    </div>
                                </div>
                                <div id="ecpay_invoice_carrier_number" t-att-class="'d-none' if default_vals['carrier_type'] in ['0', '1'] else ''" class="row">
                                    <div class="col-md-7">
                                        <label for="l10n_tw_edi_carrier_number" class="form-label">Carrier Number</label>
                                        <div class="input-group">
                                            <input
                                                class="form-control"
                                                id="l10n_tw_edi_carrier_number"
                                                maxlength="20"
                                                name="l10n_tw_edi_carrier_number"
                                                type="text"
                                                t-att-value="default_vals['carrier_number']"
                                            />
                                            <button type="button" id="validate_carrier_number" class="btn btn-outline-primary btn-sm d-none">
                                                Validate Carrier Number
                                            </button>
                                            <button type="button" id="reenter_carrier_number" class="btn btn-outline-primary btn-sm d-none">
                                                ReEnter Carrier Number
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div id="ecpay_invoice_love_code" t-att-class="'d-none' if default_vals['print_group'] != '2' else ''" class="row">
                                <div class="col-md-7">
                                    <label for="l10n_tw_edi_love_code" class="form-label">Love Code</label>
                                    <div class="input-group">
                                        <input
                                            class="form-control"
                                            id="l10n_tw_edi_love_code"
                                            maxlength="7"
                                            name="l10n_tw_edi_love_code"
                                            type="text"
                                            placeholder="Love code format is 3-7 digits"
                                            t-att-value="default_vals.get('love_code')"
                                        />
                                        <button type="button" id="validate_love_code" class="btn btn-outline-primary btn-sm d-none">
                                            Validate Love Code
                                        </button>
                                        <button type="button" id="reenter_love_code" class="btn btn-outline-primary btn-sm d-none">
                                            ReEnter Love Code
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <t t-call="website_sale.navigation_buttons">
                            <t t-set="_form_send_navigation" t-value="True"/>
                            <t t-set="_cta_classes" t-value="'a-submit a-submit-disable a-submit-loading'"/>
                        </t>
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    </form>
                </div>
            </section>
        </t>
    </template>

    <template id="address" inherit_id="website_sale.address">
        <div id="div_state" position="after">
            <div class="row m-0 mb-3 p-0">
                <div class="col-xl-6">
                    <label class="col-form-label" for="invoice_edi_format">Electronic format</label>
                    <select name="invoice_edi_format" class="form-select">
                        <option value=""/>
                        <t t-foreach="invoice_edi_formats" t-as="format">
                            <option t-att-value="format" t-att-selected="(invoice_edi_format or partner_sudo.invoice_edi_format) == format">
                                <t t-esc="format_value"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>
        </div>
    </template>
</odoo>
